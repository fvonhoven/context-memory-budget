# Anthropic API key. Read only by scripts/measure.ts. When set, summarization, fact extraction and probe answering run against the live Messages API and a replay file is recorded under data/replay/.
ANTHROPIC_API_KEY=
# Optional. Model used for live runs and for the cost arithmetic. Defaults to claude-sonnet-4-5. Must have a price in src/pricing.ts.
MEASURE_MODEL=
# Optional. Comma separated token budgets to measure. Defaults to 4096,16384.
BUDGETS=
